{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/rebuild-index.js",
            "description": "每次修改 _notes/ 後自動重建搜尋索引"
          }
        ]
      }
    ]
  }
}